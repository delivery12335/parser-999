BOT_TOKEN=
# Первый пользователь, который взаимодействует с новой БД, атомарно становится владельцем.
CHECK_INTERVAL=300
DATABASE_URL=sqlite+aiosqlite:///apartments.db
ANDROID_API_TOKEN=replace-with-at-least-32-random-characters
# iphone: бот отправляет нативную карточку контакта; android: команда приложению-компаньону
CALL_MODE=iphone
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
PUBLIC_BASE_URL=https://bot.example.com

# Public 999.md search page. Update this URL from a filter search in your browser
# if 999.md changes its option identifiers. The parser never bypasses protection.
SEARCH_URL=https://999.md/ru/list/real-estate/apartments-and-rooms?sort_type=date_desc&o_16_1=912
REQUEST_TIMEOUT=20
PARSER_PAGES=2
USER_AGENT=ApartmentWatcher/1.0 (+personal, low-frequency public-page monitor)
LOG_LEVEL=INFO
